# Runtime
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
PORT=3220
DISCORD_BOT_TOKEN=
LOG_CHANNEL_ID=
NEW_RELIC_LICENSE_KEY=

# Postgres (Drizzle)
DATABASE_URL=postgresql://user:password@localhost:5432/english_quiz

# Redis (IORedis + BullMQ)
REDIS_URL=redis://localhost:6379

# LLM (OpenRouter)
OPENROUTER_API_KEY=sk-or-...

# Admin auth (Better Auth) — bảo vệ /admin/*, /english/* admin-only và /queues
# BETTER_AUTH_SECRET: min 32 ký tự, sinh bằng `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-min-32-chars-random-secret
# BETTER_AUTH_URL: origin công khai của chính API này (dùng cho OAuth callback)
BETTER_AUTH_URL=http://localhost:3220
# Origin được phép gọi API (CSV) — phải chứa origin của dashboard
TRUSTED_ORIGINS=http://localhost:5542
# Domain dùng chung cookie giữa các subdomain (vd .abc.com). Bỏ trống khi chạy local.
AUTH_COOKIE_DOMAIN=

# Google OAuth (tuỳ chọn — thiếu thì chỉ tắt nút "đăng nhập bằng Google")
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail (Resend) — dùng cho reset password. Thiếu 2 biến này thì reset password bị tắt.
# Dev có thể dùng onboarding@resend.dev (chỉ gửi được tới email chủ tài khoản Resend).
RESEND_API_KEY=
MAIL_FROM="English Quiz <onboarding@resend.dev>"

# Seed admin đầu tiên (`bun run db:seed:admin`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

NODE_ENV=test
TZ=Asia/Ho_Chi_Minh
PORT=3399

# Database RIÊNG cho test — KHÔNG trỏ về DB dev/prod.
# Test chạy TRUNCATE toàn bảng giữa mỗi case, trỏ nhầm là mất sạch data.
# Tạo 1 lần:  createdb english_quiz_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english_quiz_test

# Chỉ để cron.config.ts parse được lúc import. Test mock @/configs/redis.config
# nên KHÔNG có kết nối Redis thật nào được mở.
REDIS_URL=redis://localhost:6379/15

BETTER_AUTH_SECRET=test-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3399
TRUSTED_ORIGINS=http://localhost:5542

# Key GIẢ. aiClient.config.ts throw ngay lúc import nếu thiếu biến này, nên phải có giá trị.
# Không bao giờ được dùng để gọi mạng: test/setup.ts thay generateStructuredOutput() bằng mock,
# và mock sẽ throw nếu test quên enqueue fixture -> không có đường nào lọt ra OpenRouter thật.
OPENROUTER_API_KEY=test-key-never-used-generateStructuredOutput-is-mocked
RESEND_API_KEY=
MAIL_FROM="English Quiz Test <test@example.com>"
